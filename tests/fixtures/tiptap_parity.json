        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "site",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "https://e.com/?a=1&b=\"2\"",
                      "target": "_blank"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " plain",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "/<x>"
