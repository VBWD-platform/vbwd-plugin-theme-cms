{
  "source": "vbwd-fe-user/plugins/cms/src/views/CmsPageTypeBase.vue renderNode (S152-06a parity; expected_html generated by running a verbatim JS copy of renderNode in node 22)",
  "cases": [
    {
      "name": "empty_doc",
      "doc": {
        "type": "doc"
      },
      "expected_html": ""
    },
    {
      "name": "paragraph_text",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Hello world"
              }
            ]
          }
        ]
      },
      "expected_html": "<p>Hello world</p>"
    },
    {
      "name": "empty_paragraph_is_nbsp",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph"
          }
        ]
      },
      "expected_html": "<p>&nbsp;</p>"
    },
    {
      "name": "text_is_escaped",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "a < b & \"c\" > 'd'"
              }
            ]
          }
        ]
      },
      "expected_html": "<p>a &lt; b &amp; &quot;c&quot; &gt; 'd'</p>"
    },
    {
      "name": "headings_levels_and_default",
      "doc": {
        "type": "doc",
        "content": [
          {
            "type": "heading",
            "attrs": {
              "level": 1
            },
            "content": [
              {
                "type": "text",
                "text": "One"
              }
            ]
          },
          {
            "type": "heading",
            "attrs": {
              "level": 3
            },
            "content": [
              {
                "type": "text",
                "text": "Three"
              }
            ]
          },
          {
            "type": "heading",
            "content": [
              {
                "type": "text",
                "text": "Default"
              }
            ]
          }
        ]
      },
      "expected_html": "<h1>One</h1><h3>Three</h3><h2>Default</h2>"
    },
    {
