{#- PostCard.vue — one card of a post listing (expects ``card``). -#}
{%- from "cms/components/_cms_image.html.j2" import cms_image -%}
<article class="post-card post-card--{{ card.mode }}" data-testid="post-card">
{%- if card.mode == 'category' -%}
<div class="post-card__content">
{%- if card.category %}<a href="{{ card.category.href }}" class="post-card__eyebrow" data-testid="post-category">{{ card.category.name }}</a>{% endif -%}
<h2 class="post-card__title"><a href="{{ card.detail_path }}">{{ card.title }}</a></h2>
<div class="post-card__meta" data-testid="post-meta">
{%- if card.type_badge %}<span class="post-card__badge post-card__badge--{{ card.type_badge.kind }}" data-testid="post-type-badge"><svg class="post-card__badge-icon" viewBox="0 0 16 16" aria-hidden="true" width="12" height="12">
{%- if card.type_badge.kind == 'page' %}<path fill="currentColor" d="M4 1.5A1.5 1.5 0 0 1 5.5 0h4.1a1.5 1.5 0 0 1 1.06.44l2.4 2.4A1.5 1.5 0 0 1 13.5 3.9V14.5A1.5 1.5 0 0 1 12 16H5.5A1.5 1.5 0 0 1 4 14.5zm5.5.1V3.5a1 1 0 0 0 1 1h1.9zM6 7.5a.75.75 0 0 0 0 1.5h5a.75.75 0 0 0 0-1.5zm0 3a.75.75 0 0 0 0 1.5h3a.75.75 0 0 0 0-1.5z"></path>
{%- else %}<path fill="currentColor" d="M2 3.5A1.5 1.5 0 0 1 3.5 2h9A1.5 1.5 0 0 1 14 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-9A1.5 1.5 0 0 1 2 12.5zM4.75 5a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5zm0 3a.75.75 0 0 0 0 1.5h6.5a.75.75 0 0 0 0-1.5zm0 3a.75.75 0 0 0 0 1.5h3.5a.75.75 0 0 0 0-1.5z"></path>{% endif -%}
</svg> {{ card.type_badge.label }}</span>{% endif -%}
{%- if card.date_label %}<time class="post-card__meta-item post-card__meta-item--date">{{ card.date_label }}</time>{% endif -%}
{%- for item in card.meta %}<span class="post-card__meta-item post-card__meta-item--{{ item.field }}">{{ item.value }}</span>{% endfor -%}
</div>
{%- include "cms/components/_post_card_tags.html.j2" -%}
{%- if card.category_excerpt %}<p class="post-card__excerpt">{{ card.category_excerpt }}</p>{% endif -%}
</div>
{%- if card.thumb %}<a href="{{ card.detail_path }}" class="post-card__thumb" tabindex="-1" aria-hidden="true">{{ cms_image(card.thumb, card.title) }}</a>{% endif -%}
{%- else -%}
{%- if card.lead_image %}<a href="{{ card.detail_path }}" class="post-card__media">{{ cms_image(card.lead_image, card.title) }}</a>{% endif -%}
<h2 class="post-card__title"><a href="{{ card.detail_path }}">{{ card.title }}</a></h2>
{%- if card.meta %}<div class="post-card__meta" data-testid="post-meta">{% for item in card.meta %}<span class="post-card__meta-item post-card__meta-item--{{ item.field }}">{{ item.value }}</span>{% endfor %}</div>{% endif -%}
{%- include "cms/components/_post_card_tags.html.j2" -%}
{%- if card.excerpt %}<p class="post-card__excerpt">{{ card.excerpt }}</p>{% endif -%}
{%- if card.body_html %}<div class="post-card__body">{{ card.body_html }}</div>{% endif -%}
{%- endif -%}
</article>
